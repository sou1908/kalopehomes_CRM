# Copy this to .env.local (local) or set these on the host (production).
# Every variable the app reads is listed here — there are no others.

# ── Database (MySQL) ──────────────────────────────────────────────────────────
# Create the database and its user in Hostinger's control panel, then copy the
# four values here. The app creates its own tables on first boot.
#
# The host is usually "localhost" when the app and the database sit on the same
# plan. Hostinger's own panel shows the exact hostname to use.
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_DATABASE="u550926335_leadcrm"
MYSQL_USER="u550926335_leadcrm"
MYSQL_PASSWORD=""

# Alternative to the five above, if you prefer one string:
# DATABASE_URL="mysql://user:password@host:3306/dbname"

# Shared hosting caps how many connections one account may hold open. 5 is
# comfortable; raise only if the host allows it and pages start queueing.
# MYSQL_POOL_SIZE="5"

# ── Uploaded files ────────────────────────────────────────────────────────────
# READ THIS BEFORE DEPLOYING. In production this MUST point somewhere OUTSIDE
# the application folder.
#
# A git-based deploy replaces the app folder with a fresh copy of the repo, and
# uploads are not in the repo — they are gitignored, because they hold customer
# material. Left inside the app folder, every deploy deletes every site photo.
# Point it at a sibling directory and a deploy cannot touch it.
#
#   Production example (adjust the username to yours):
#     UPLOAD_DIR="/home/USER/leadcrm-uploads"
#
# The database no longer has this problem — MySQL keeps its own storage, which
# is one of the reasons for moving off a SQLite file.
UPLOAD_DIR="./uploads"

# ── The organisation ──────────────────────────────────────────────────────────
ORG_NAME="Kalope Homes"
ORG_SLUG="kalope-homes"

# ── The first admin account ───────────────────────────────────────────────────
# Created on first run if it does not exist.
#
# NOTE: this password is currently re-applied on every boot, so changing it
# inside the app is undone at the next restart. Change it HERE.
ADMIN_EMAIL="you@yourdomain.com"
ADMIN_PASSWORD="pick-a-long-random-password"
ADMIN_NAME="Your Name"

# ── The follow-up digest endpoint ─────────────────────────────────────────────
# /api/cron/follow-up-digest refuses to run without this, so if it is missing
# the digest silently stops. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=""

# ── Port ──────────────────────────────────────────────────────────────────────
# Not read by our code — Next.js reads it directly. Most managed hosts set this
# for you; leave it unset locally and `npm start` picks 3000.
# PORT="3001"
