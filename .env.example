# Copy this to .env.local and fill in real values
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
DATABASE_PATH="./data/issuetracker.db"
UPLOAD_DIR="./uploads"
PUBLIC_BASE_URL="http://localhost:3000"

# Single admin (single-tenant deployment). Auto-created on first run.
ADMIN_EMAIL="you@yourdomain.com"
ADMIN_PASSWORD="pick-a-strong-password"
ADMIN_NAME="Your Name"

# Razorpay (test mode keys from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Pricing: amount in paise (INR cents). 99900 = ₹999
PRICE_PER_EXTRA_ITERATION_PAISE="99900"
FREE_ITERATIONS_PER_PROJECT="5"
